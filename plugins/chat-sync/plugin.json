{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "chat-sync",
  "version": "0.8.0",
  "description": "Sync local Codex chat histories across desktop profiles.",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Codex Chat Sync",
        "shortDescription": "Sync local desktop chats",
        "longDescription": "Exchange Codex conversations through a private folder, with optional appearance and chat preferences, sidebar organization and colours.",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": "Open Mod Controls.",
        "developerName": "Capronicus"
      },
      "requires_local_executor": true,
      "onboardingSkill": "./skills/sync-chats/SKILL.md"
    }
  },
  "author": {
    "name": "Capronicus"
  },
  "repository": "https://github.com/Capronicus/codex-desktop-mods"
}
